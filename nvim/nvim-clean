-- ── 5. Commands ───────────────────────────────────────────────────────────────

vim.api.nvim_create_user_command("MkFile", function()
	local path = vim.fn.expand("%:p")
	if path == "" then
		vim.notify("No filename set — use  :file <path>  first.", vim.log.levels.ERROR)
		return
	end
	local dir = vim.fn.fnamemodify(path, ":h")
	if vim.fn.isdirectory(dir) == 0 then
		local ok, err = pcall(vim.fn.mkdir, dir, "p")
		if not ok then
			vim.notify("Failed to create directory: " .. (err or dir), vim.log.levels.ERROR)
			return
		end
		vim.notify("Created: " .. dir, vim.log.levels.INFO)
	end
	vim.cmd("write")
end, { desc = "Create missing parent directories and write file" })

